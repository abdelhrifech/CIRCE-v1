# Copier vers .env (non versionné). Aucun secret réel ici.
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3001
# Base SQLite (fichier), chemin relatif à apps/api (Q-343)
DATABASE_URL=file:./prisma/dev.db
# Fournisseur d'identité de dev (Q-001) : refusé si NODE_ENV=production
IDENTITY_PROVIDER=dev
DEV_IDENTITY_SECRET=change-me-dev-only-secret
# Utilisateur injecté par le relais web en dev (créé par `pnpm dev:user <identifiant> <rôle> [plateformes]`)
DEV_IDENTITY_USER=dev.coord
# Serveur web : URL de l'API relayée sous /api
API_URL=http://127.0.0.1:3001
WEB_PORT=3000
# Mails (D-19, Q-409) : « dev » = boîte d'envoi simulée (aucun mail réel). « smtp » exige SMTP_HOST et MAIL_EXPEDITEUR.
MAIL_MODE=dev
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_SECURE=false   (SMTP_USER exige SMTP_SECURE=true : jamais d'identifiants en clair, Q-413)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_EXPEDITEUR=
# Ordonnanceur interne (D-20, Q-410) : les horaires se règlent dans Règles métier (vides = désactivé)
ORDONNANCEUR_ACTIF=true

# Sondes techniques, distinctes des routes métier (port libre choisi par start:all si nécessaire en local)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=9180
ADMIN_READY_TIMEOUT_MS=2000
# OpenTelemetry : aucun export local sans endpoint. Fournir les valeurs du collecteur au déploiement.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=circe-api
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=circe,service.version=tag-du-build,deployment.environment.name=staging
