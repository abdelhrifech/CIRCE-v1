{
  "name": "@circe/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:up": "tsx scripts/db.ts dev",
    "db:test:up": "tsx scripts/db.ts test",
    "seed:ref": "tsx scripts/seed-ref.ts",
    "jdd": "tsx scripts/jdd.ts",
    "dev:user": "tsx scripts/dev-user.ts",
    "e2e:seed": "tsx scripts/e2e-seed.ts",
    "seed:demo": "tsx scripts/e2e-seed.ts --demo",
    "seed:centres": "tsx scripts/seed-centres.ts",
    "integration:lot": "tsx scripts/integration-lot.ts",
    "taches:executer": "tsx scripts/taches.ts",
    "seed:news": "tsx scripts/seed-news.ts",
    "seed:scenarios": "tsx scripts/seed-scenarios.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@circe/shared": "workspace:*",
    "@fastify/otel": "1.0.1",
    "@fastify/swagger": "9.9.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/instrumentation": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/better-sqlite3": "9.6.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
