// Modèle de données CIRCE V2 — étape 3.
// Base SQLite (Q-343). Noms métier français conservés avec @@map/@map vers le schéma réel (Q-341).
// Décisions : Q-300 (statut persisté), Q-306 (lien n–n avec quantité), Q-307 (entité Réception),
// Q-004/Q-319 (seed minimal), Q-301 (un enum par entité), Q-308 (journal + historique de statut).
// Conventions : onDelete Restrict par défaut ; entités modifiables = version, createdAt, updatedAt,
// createdById, updatedById (auteurs = id Utilisateur, vérifiés par le service, sans FK : voir
// ANALYSE_MODELE_DONNEES.md §4). Les enums sont du TEXT en SQLite (pas de CHECK en base).
// Index unique partiel de la ligne attendue : SQL brut dans la migration (Q-305).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

